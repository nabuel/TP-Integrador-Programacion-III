<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

    <main>

        <section class="form-inicio-sesion">

            <h2>Iniciar sesión</h2>

            <form action="/login" method="POST">

                <label for="email">Email</label>
                <input type="email" placeholder="admin@gmail.com" name="email" id="emailUser" required>

                <label for="password">Constraseña</label>
                <input type="password" placeholder="3 a 12 caracteres" name="password" id="passwordUser" required>

                <input type="submit" value="Iniciar sesión">
                
            </form>

            <form action="/registrar">

                <label for"registrar"></label>
                <input type="submit" value="Registrarse">

            </form>

        </section>

    </main>

<%- include("partials/footer.ejs") %> 