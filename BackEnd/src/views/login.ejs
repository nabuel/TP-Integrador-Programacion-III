<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

    </header>

    <main>

        <section class="form-inicio-sesion">

            <h2 class="color-titulos sombra-texto centrado font-40"> <%= about %> </h2>

            <form action="/login" method="POST">

                <label class="sombra-texto" for="email">Email</label>
                <input type="email" placeholder="admin@gmail.com" name="email" id="emailUser" required>

                <label class="sombra-texto" for="password">Constraseña</label>
                <input type="password" placeholder="3 a 12 caracteres" name="password" id="passwordUser" required>

                <input class="boton sombra-texto" type="submit" value="Iniciar sesión">
                <input class="boton sombra-texto" id="acceso-tester" type="submit" value="Acceso tester">

                
            </form>

            <% if (typeof error !== "undefined") { %>
		        <p class="mensaje-error"> <%= error %> </p>
            <% } %> 
            
        </section>

    </main>

    <script>

        const emailUser = document.getElementById("emailUser");
        const passwordUser = document.getElementById("passwordUser");
        const btnAcceso = document.getElementById("acceso-tester");

        btnAcceso.addEventListener("click", () => {
            emailUser.value = "goku@dbz.com";
            passwordUser.value = "goku";
        });
    </script>

<%- include("partials/footer.ejs") %> 