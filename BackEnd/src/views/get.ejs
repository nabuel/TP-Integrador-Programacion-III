<%- include("partials/head.ejs") %>
<!-- Incluimos los fragmentos ejs faltantes -->
<%- include("partials/header.ejs") %>

    <nav>

            
            <a id="boton-cerrarsesion" href="/logout"><img src="/img/user-logout.png" alt="icono-logout"></a>
                
            <a id="boton-crearusuario" href="/api/usuarios/registrar"><img src="/img/user-create-logo.png" alt="icono-crearuser"></a>

            

        </nav>

    </header>

    <main>
        <section id="get-producto-by-id">
            <form id="formGetById">

                <label for="idProducto">ID del producto</label>
                <input type="number" min="1" name="idProducto">

                <input type="submit" value="Buscar producto">

        </section>

        <section id="contenedor-productos">
            <!--Ahora desde EJS podemos iterar directamente desde aca -->
                <% listaProductos.forEach(producto => { %>
                    <div class="card-producto">
                        <img src="/img/<%=producto.imagen%>" alt="<%=producto.nombre%>">
                        <p class="nombre-prod"><%=producto.nombre%></p>
                        <p class="precio-prod"><%=producto.precio%>$</p>
                    </div>
                <% }) %>
                

        </section>
    </main>

    <script src="/js/get.js"></script>
<%- include("partials/footer.ejs") %>