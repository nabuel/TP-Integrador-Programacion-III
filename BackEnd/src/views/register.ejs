<%- include("partials/head.ejs") %>
<%- include("partials/header.ejs") %>

    </header>

    <main>

        <section class="form-registro">

            <h2> <%= about %> </h2>

            <form action="/api/usuarios/registrar" method="POST">

                <label for="name">Nombre</label>
                <input type="name" name="name" id="nombreUsuario" required>

                <label for="email">Email</label>
                <input type="email" name="email" id="emailUser" required>

                <label for="password">Contraseña</label>
                <input type="password" placeholder="3 a 12 caracteres" name="password" id="passwordUser" required>

                <input type="submit" value="Registrar">

            </form>

            <% if (typeof error !== "undefined") { %>
		        <p class="mensaje-error"> <%= error %> </p>
            <% } else if (typeof exito !== "undefined") { %>
                <p class="mensaje-exito"> <%= exito %> </p>
            <% } %>  
            
        </section>

    </main>

<%- include("partials/footer.ejs") %> 